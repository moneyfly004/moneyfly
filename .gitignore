android/app/libs/*.jar
mihomo-bin/

# 离线分流数据（CI 构建时从 MetaCubeX/meta-rules-dat 下载，不在仓库里存；
# 本地开发用 tool/fetch_geodata.sh 获取）
assets/rules/*.dat
assets/rules/*.mmdb
