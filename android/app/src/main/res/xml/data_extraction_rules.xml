<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+（API 31+）备份/迁移规则：全部排除。
  配合 AndroidManifest 的 allowBackup=false + fullBackupContent=false：
  应用数据绝不进入云备份、也绝不随设备迁移，卸载即彻底消失，
  重装后是全新状态（重新登录 + 重新拉取订阅），不会恢复旧配置。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
