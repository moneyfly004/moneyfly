<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 注意：不启用 App Sandbox —— v1 直接分发模式，sing-box 子进程需要
	     设置系统代理（SCDynamicStore），Sandbox 会阻止导致“已连接但无流量”。 -->
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- flutter_secure_storage（token 存储）必需：Keychain 访问组，
	     缺失会报 -34018（A required entitlement isn't present）导致无法登录 -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(CFBundleIdentifier)</string>
	</array>
	<!-- v2 上 Network Extension 时追加（需 Apple Developer 账号）：
	<key>com.apple.developer.networking.networkextension.packet-tunnel-provider</key>
	<true/>
	-->
</dict>
</plist>
